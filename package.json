{
  "name": "takhi-fieldbook",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "share": "node scripts/share.js",
    "test": "node --test",
    "ml:setup": "uv venv --python 3.12 .venv && uv pip install --python .venv/bin/python -r requirements-ml.txt && .venv/bin/python ml/download_model.py",
    "catalog:seed": ".venv/bin/python ml/seed_catalog.py",
    "kaggle:prepare": "node scripts/prepare_kaggle_dataset.js",
    "photos:fetch": ".venv/bin/python ml/fetch_photos.py",
    "ml:detector-setup": ".venv/bin/python ml/detect_horses.py data/ml/yolo26x.pt",
    "benchmark:build": ".venv/bin/python ml/build_benchmark.py",
    "benchmark:evaluate": ".venv/bin/python ml/evaluate_benchmark.py",
    "benchmark:stress": "TAKHI_CPU=1 .venv/bin/python ml/stress_benchmark.py",
    "benchmark:expand": ".venv/bin/python ml/expand_benchmark.py",
    "benchmark:new": "TAKHI_CPU=1 .venv/bin/python ml/evaluate_new.py",
    "benchmark:large-build": ".venv/bin/python ml/build_large_audit.py",
    "benchmark:large-expand": ".venv/bin/python ml/expand_large_audit.py",
    "benchmark:large-evaluate": "TAKHI_CPU=1 .venv/bin/python ml/evaluate_large_audit.py",
    "benchmark:extra-build": ".venv/bin/python ml/build_extra_audit.py",
    "benchmark:multiview": "TAKHI_CPU=1 .venv/bin/python ml/evaluate_multiview.py",
    "benchmark:identity-demo": "TAKHI_CPU=1 .venv/bin/python ml/evaluate_identity_demo.py",
    "benchmark:reserve": "TAKHI_CPU=1 .venv/bin/python ml/evaluate_reserve_zip.py",
    "dataset:inspect": ".venv/bin/python ml/inspect_dataset.py",
    "train:hard-negatives": "TAKHI_CPU=1 .venv/bin/python ml/retrain_hard_negatives.py",
    "train:large-audit": "TAKHI_CPU=1 .venv/bin/python ml/train_large_audit.py",
    "train:extra-audit": "TAKHI_CPU=1 .venv/bin/python ml/train_extra_audit.py",
    "train:promote-guard": ".venv/bin/python ml/promote_hard_guard.py",
    "train:species-expanded": "TAKHI_CPU=1 .venv/bin/python ml/train_species_expanded.py",
    "train:horse30": ".venv/bin/python ml/train.py",
    "train:catalog": ".venv/bin/python ml/train.py --catalog"
  },
  "engines": { "node": ">=20" }
}
